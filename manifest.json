{
  "manifest_version": 3,
  "name": "Research Reading Assistant",
  "version": "0.1.0",
  "description": "Detect and extract research paper structure (title, abstract, sections, figures, methods, conclusion) from web pages.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "storage", "offscreen"],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Research Reading Assistant"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["storage/papers.js", "content/detector.js", "content/content.js"],
      "run_at": "document_idle"
    }
  ]
}
